rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return request.auth != null && 
             request.auth.token.email == 'sarovarlakes@gmail.com' && 
             request.auth.token.email_verified == true; 
    }
    function isValidResume(data) {
      return data.keys().hasAll(['hero', 'contact', 'education', 'experiences', 'skillCategories', 'featuredProjects']);
    }
    function incoming() { return request.resource.data; }

    match /{document=**} {
      allow read, write: if false;
    }

    match /resumes/{resumeId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(resumeId) && isValidResume(incoming());
      allow update: if isAdmin() && isValidId(resumeId) && isValidResume(incoming());
      allow delete: if isAdmin() && isValidId(resumeId);
    }
  }
}
